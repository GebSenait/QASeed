# Local environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
test-results/
*.log

# Secrets. .env.example is the only env file that may be committed.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Local databases
*.db
*.sqlite3
*.sqlite
*.db-journal

# Private project reference documents (never commit)
_project_references/

# Local-only test notes and failure screenshots (kept outside the repo in QASeed_local_reports/; never commit)
e2e_hosted_summary*.md
reports/**/e2e_screenshots/
