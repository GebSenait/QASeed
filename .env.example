# Copy to .env for local runs. .env is gitignored.
# Put real credentials only in .env, never in this file.

# Local SQLite path. Database files (*.db, *.sqlite3) are gitignored.
QASEED_DB_PATH=data/qaseed.db

# Connectivity check only (python -m qaseed.llm_ping).
# Leave the key empty to record SKIPPED. Put a real key only in .env.
# OPENAI_API_KEY=
# Set this to a model ID your own account lists. Do not guess one.
# OPENAI_MODEL=
