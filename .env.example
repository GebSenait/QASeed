# QASeed settings template. Copy to .env and fill in your own values.
# .env is gitignored. Never put a real key in this file.

# Local SQLite path (database files are gitignored).
QASEED_DB_PATH=data/qaseed.db

# Google Gemini (free tier). Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: minimal | low | medium | high (unset = model default)
# GEMINI_THINKING_LEVEL=
